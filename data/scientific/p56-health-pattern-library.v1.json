        { "name": "Iron-deficiency (nutritional) pattern", "requires": "a verified classification of ferritin interpreted with inflammation markers" }
      ],
      "recommendations": {
        "concern": [
          { "category": "further_examination", "authorization": "clinician_required", "text": "Ground Medical should investigate possible nutritional, inflammatory or blood-loss contributions; iron or other supplementation must be decided by the clinician." },
          { "category": "nutrition", "authorization": "clinician_required", "text": "Ground Medical should review dietary iron and energy intake; MITOCHONDRIA does not suggest supplements or doses." }
        ],
