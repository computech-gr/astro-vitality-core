# Browser-safe Supabase configuration for an environment you are authorized to use.
# Never place service-role keys, database passwords, private API tokens, or other
# server-only credentials in VITE_* variables.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side equivalents used by generated integration helpers during SSR.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional non-production site-origin override. Lovable preview hosts are rejected
# as canonical by src/infrastructure/config.ts.
VITE_SITE_ORIGIN=http://localhost:3000
